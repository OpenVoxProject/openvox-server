INSTALL_DIR="/opt/puppetlabs/server/apps/<%= EZBake::Config[:real_name] %>"

if [ -n "$JRUBY_JAR" ]; then
  echo "Warning: the JRUBY_JAR setting is no longer needed and will be ignored." 1>&2
fi

java_version=$($JAVA_BIN -version 2>&1 | head -1 | awk -F\" '{ print $2 }')
java_major_version=$(echo $java_version | awk -F. '{ print $1 }')

if [[ $java_major_version -ge 21 ]]; then

	if ! grep -Eq 'add-opens|enable-native-access' <<<"$JAVA_ARGS"; then
		export JAVA_ARGS="<%= EZBake::Config[:java_args_dist] %> ${JAVA_ARGS}"
	fi

	if ! grep -Eq 'add-opens|enable-native-access' <<<"$JAVA_ARGS_CLI"; then
		export JAVA_ARGS_CLI="<%= EZBake::Config[:java_args_dist] %> ${JAVA_ARGS_CLI}"
	fi
fi

# Only the FIPS packages ship this file. The service gets it through JAVA_ARGS,
# and the CLI subcommands need the same crypto providers.
fips_properties="/opt/puppetlabs/server/data/<%= EZBake::Config[:real_name] %>/java.security.fips"
if [[ -e "$fips_properties" ]] && ! grep -q 'java.security.properties' <<<"$JAVA_ARGS_CLI"; then
	export JAVA_ARGS_CLI="-Djava.security.properties==${fips_properties} ${JAVA_ARGS_CLI}"
fi

CLASSPATH="/opt/puppetlabs/server/data/<%= EZBake::Config[:real_name] %>/jars/*:${CLASSPATH}"
